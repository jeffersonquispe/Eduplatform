# Supabase local: ejecuta `npx supabase status` para ver estos valores.
# Solo clave pública (anon): nunca pongas la service_role aqui.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Origen del servicio Edy (edy-service). Sin esta variable no se muestra el asistente.
# Se incluye en el build: cambiarla requiere recompilar. En produccion debe usar HTTPS.
NEXT_PUBLIC_EDY_URL=http://localhost:8000

# Cuentas para las pruebas E2E (Playwright): se inicia sesion una vez por rol y se reutiliza la sesion.
# Pon aqui tus credenciales reales en .env.local; nunca en el codigo ni en este archivo.
E2E_INSTRUCTOR_EMAIL=
E2E_INSTRUCTOR_PASSWORD=
E2E_STUDENT_EMAIL=
E2E_STUDENT_PASSWORD=
